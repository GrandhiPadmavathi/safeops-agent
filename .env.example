# ollama (local, default) or groq (hosted, free tier)
SAFEOPS_LLM_PROVIDER=ollama
SAFEOPS_OLLAMA_BASE_URL=http://localhost:11434
SAFEOPS_OLLAMA_MODEL=qwen2.5:3b

SAFEOPS_GROQ_MODEL=qwen/qwen3.8-27b
# SAFEOPS_GROQ_API_KEY=your-key-here

SAFEOPS_AGENT_MAX_STEPS=10

# Sign-in. Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SAFEOPS_AUTH_JWT_SECRET=
SAFEOPS_AUTH_TOKEN_MINUTES=30
SAFEOPS_AUTH_DEMO_USERS=true
SAFEOPS_AUTH_DEMO_PASSWORD=safeops-demo

# Optional single sign-on (Microsoft Entra ID shown; any OpenID Connect provider works)
# SAFEOPS_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# SAFEOPS_OIDC_AUDIENCE=api://<app-client-id>
# SAFEOPS_OIDC_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
# SAFEOPS_OIDC_ROLES_CLAIM=roles
